# UP Board backend configuration — copy to backend/.env for local runs without Docker.
# NEVER commit real secrets (ADR-001 security considerations).

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://upboard:change_me@localhost:5432/upboard

# >= 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed frontend origins (CORS + refresh-token Origin check)
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
# Production (Vercel + Render on different sites): COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# local (development) | s3 (production, requires `pip install boto3`)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_PUBLIC_BASE_URL=

RATE_LIMIT_ENABLED=true

# Used by database/seeders/seed.py
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
DEMO_PASSWORD=
