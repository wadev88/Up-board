# Root .env for `docker compose up` (local development only — ADR-002 decision 10).
# Copy to .env and change every value. Never commit .env.

POSTGRES_USER=upboard
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=upboard

# >= 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# First admin account created by database/seeders/seed.py (password >= 12 chars)
BOOTSTRAP_ADMIN_EMAIL=admin@up.ac.th
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password

# Password for demo accounts (demo.student / teacher / staff / facilities / technician / club / admin @up.ac.th)
DEMO_PASSWORD=change-this-demo-password

# --- Google sign-in through Supabase Auth (ADR-003) — optional for local development ---
# Supabase dashboard → Project Settings → API. The URL and anon/publishable key are PUBLIC values.
# NEVER put the service_role key here or anywhere in the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only if the project still uses the legacy shared JWT secret (new projects use signing keys / JWKS)
SUPABASE_JWT_SECRET=

# Local development keeps email/password sign-up (production: false — Google only)
PASSWORD_SIGNUP_ENABLED=true
# Spam policy (3 consecutive general posts per Bangkok day → warning, 5 → 1-day suspension);
# set to false only for tests
SPAM_POLICY_ENABLED=true
